{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start-hook.sh\"",
            "powershell": "& \"$env:CLAUDE_PLUGIN_ROOT\\scripts\\run-hook.ps1\" session-start-hook.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/user-prompt-hook.sh\"",
            "powershell": "& \"$env:CLAUDE_PLUGIN_ROOT\\scripts\\run-hook.ps1\" user-prompt-hook.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/post-tool-hook.sh\"",
            "powershell": "& \"$env:CLAUDE_PLUGIN_ROOT\\scripts\\run-hook.ps1\" post-tool-hook.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/session-end-hook.sh\"",
            "powershell": "& \"$env:CLAUDE_PLUGIN_ROOT\\scripts\\run-hook.ps1\" session-end-hook.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
